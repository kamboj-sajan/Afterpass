# Copy to .env and fill in. Never commit .env.
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
BEDROCK_MODEL_ID=
# Agent model as provider:model. Default mantle:openai.gpt-oss-120b (Bedrock's OpenAI-compatible
# endpoint). Set to bedrock to use BEDROCK_MODEL_ID through the Converse API.
AGENT_MODEL=
# The account is locked to Sydney; nothing can be created in other regions.
AWS_REGION=ap-southeast-2
# Where pipeline failure emails go. Passed to the stack at deploy time.
ALERT_EMAIL=
