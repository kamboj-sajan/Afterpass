# Copy to .env.local and adjust. Never commit real keys.
# Where the published data lives. Locally: `make serve-data`.
VITE_DATA_BASE_URL=http://127.0.0.1:8787
# Amazon Location API key for the basemap. Leave empty to use the CARTO Dark Matter fallback.
VITE_LOCATION_KEY=
VITE_AWS_REGION=us-west-2
# The agent: its Lambda Function URL when deployed. Locally, `make agent` serves it here.
VITE_AGENT_URL=http://127.0.0.1:8788
